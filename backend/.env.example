NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5500,http://localhost:3000
# Set to true if you want the backend to also serve the frontend static files (single-service deploy)
# SERVE_FRONTEND=true

# Storage adapter — "local" for dev (writes to backend/uploads/images),
# "cloudinary" for production (requires CLOUDINARY_* vars).
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
